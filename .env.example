LOKI_URL=http://localhost:3100
CLICKUP_TOKEN=pk_...
CLICKUP_LIST_ID=
# ClickUp user id'leri, virgülle
CLICKUP_ASSIGNEES=
INTERVAL_SEC=300
# Kapatılan task tekrar düşen hata için en fazla bu sıklıkta kontrol edilip yeniden açılır (dakika)
COMMENT_EVERY_MIN=60
# İlk açılışta geriye dönük kaç dakika taransın
FIRST_LOOKBACK_MIN=15
# Task açılmayacak app'ler, virgülle (Loki app etiketi)
IGNORE_APPS=
# Kim hangi app'lerin task'larına eklenir: userid=app1,app2;userid2=app3 (Loki app etiketi)
APP_OWNERS=
